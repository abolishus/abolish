{
  "name": "@abolishus/ballot",
  "version": "0.0.0",
  "private": true,
  "description": "The ballot client: a static, reproducible, hash-addressed SPA under a strict CSP, the only place votes are cast.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vp exec tsc -p tsconfig.json && vp build",
    "check": "vp check",
    "test": "vp test run --project unit",
    "test:e2e": "vp test run --project e2e",
    "test:storybook": "vp test run --project storybook",
    "storybook": "storybook dev -p 6007",
    "preview": "vp build && vp preview"
  },
  "dependencies": {
    "@abolishus/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "fast-check": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "abolish": {
    "buildOutputs": [
      "dist"
    ]
  }
}
