{
  "name": "@abolishus/api",
  "version": "0.0.0",
  "private": true,
  "description": "The public API: serves election definitions and the board over oRPC, and will take ballots. Source-only.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vp exec tsc -p tsconfig.json && vp pack",
    "check": "vp check",
    "start": "vp node src/main.ts",
    "test": "vp run test:db"
  },
  "dependencies": {
    "@abolishus/api-contract": "workspace:*",
    "@abolishus/core": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "ioredis": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@abolishus/crypto": "workspace:*",
    "@abolishus/verifier": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "abolish": {
    "buildOutputs": [
      "dist"
    ]
  }
}
