# The API's variables (src/main.ts, src/migrate.ts). Never commit real values;
# deployments set them as Railway variables (docs/runbooks/railway.md).

# main.mjs: a login granted abolish_app only, with search_path set to the schema.
# migrate.mjs: a separate login granted abolish_migrator.
DATABASE_URL=postgres://abolish_api:change-me@localhost:5432/abolish
# migrate.mjs only: the schema it migrates.
DATABASE_SCHEMA=abolish
# main.mjs only: where it listens (the image sets 0.0.0.0).
API_HOST=127.0.0.1
API_PORT=8787
