  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vp exec tsc -p tsconfig.json",
    "check": "vp check",
    "start": "vp node src/main.ts",
    "test": "vp test run"
  },
  "dependencies": {
    "@abolishus/crypto": "workspace:*",
    "@abolishus/verifier": "workspace:*",
    "@noble/hashes": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "abolish": {
    "buildOutputs": []
  }
}
